{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownlifeaudio.com/schemas/orch-terminology/catalog.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["vendorId", "libraryId", "instrumentId", "articulations"],
    "additionalProperties": false,
    "properties": {
      "vendorId": {"type": "string"},
      "libraryId": {"type": "string"},
      "instrumentId": {"type": "string"},
      "articulations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["articulationId", "variantIds"],
          "additionalProperties": false,
          "properties": {
            "articulationId": {"type": "string"},
            "variantIds": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
