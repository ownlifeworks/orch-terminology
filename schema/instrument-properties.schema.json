{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OwnLife Audio Instrument Properties",
  "type": "object",
  "required": ["schemaVersion", "loudnessReference", "instruments"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "loudnessReference": {
      "type": "object",
      "required": ["version", "unit", "dynamicAnchors"],
      "properties": {
        "version": {
          "const": 1
        },
        "unit": {
          "const": "LUFS"
        },
        "dynamicAnchors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["working", "max"]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "pitchConvention": {
          "type": "string"
        },
        "measurementRangeMeaning": {
          "type": "string"
        },
        "instrumentConventions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "instruments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["pitch", "loudness"],
        "properties": {
          "dataQuality": {
            "type": "string",
            "enum": ["measured", "approximation"]
          },
          "pitch": {
            "type": "object",
            "required": ["range", "measurementRange"],
            "properties": {
              "range": {
                "$ref": "#/$defs/midiRange"
              },
              "measurementRange": {
                "$ref": "#/$defs/midiRange"
              }
            },
            "additionalProperties": false
          },
          "loudness": {
            "type": "object",
            "properties": {
              "long": {
                "$ref": "#/$defs/sustainedLoudnessTargets"
              },
              "short": {
                "$ref": "#/$defs/sustainedLoudnessTargets"
              },
              "percussion": {
                "$ref": "#/$defs/percussionLoudnessTargets"
              }
            },
            "minProperties": 1,
            "additionalProperties": false
          },
          "references": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "long": {
                  "$ref": "#/$defs/sustainedLoudnessTargets"
                },
                "short": {
                  "$ref": "#/$defs/sustainedLoudnessTargets"
                },
                "percussion": {
                  "$ref": "#/$defs/percussionLoudnessTargets"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "midiRange": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      },
      "additionalProperties": false
    },
    "loudnessTarget": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "maxItems": 2
        }
      ]
    },
    "sustainedLoudnessTargets": {
      "type": "object",
      "required": ["working", "max"],
      "properties": {
        "working": {
          "$ref": "#/$defs/loudnessTarget"
        },
        "max": {
          "$ref": "#/$defs/loudnessTarget"
        }
      },
      "additionalProperties": false
    },
    "percussionLoudnessTargets": {
      "type": "object",
      "required": ["max"],
      "properties": {
        "max": {
          "$ref": "#/$defs/loudnessTarget"
        }
      },
      "additionalProperties": false
    }
  }
}
