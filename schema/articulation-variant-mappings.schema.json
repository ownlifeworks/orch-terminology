{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownlifeaudio.com/schemas/orch-terminology/articulation-variant-mappings.schema.json",
  "type": "object",
  "required": ["schemaVersion", "mappings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["articulationId", "baseArticulationId", "variantIds"],
        "properties": {
          "articulationId": {"type": "string"},
          "baseArticulationId": {"type": "string"},
          "variantIds": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  }
}
